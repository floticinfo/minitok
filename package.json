{
  "name": "@flotic/minitok",
  "version": "1.3.18",
  "description": "Verified repository-aware coding workflow CLI for AI agents",
  "main": "src/index.js",
  "bin": {
    "minitok": "bin/minitok.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "gui": "node bin/minitok.js gui",
    "package:cli": "node scripts/artifact-report.mjs cli",
    "sync:version-metadata": "node scripts/sync-version-metadata.mjs",
    "check:version-metadata": "node scripts/sync-version-metadata.mjs --check",
    "sync:extension-runtime": "npm run sync:version-metadata && node scripts/sync-extension-runtime.mjs",
    "package:extension": "npm run sync:extension-runtime && node scripts/package-extension.mjs",
    "release:extension": "npm run typecheck:extension && npm run extension:commercial:check && npm run extension:marketplace:check && npm run package:extension && npm run release:artifacts",
    "typecheck:extension": "tsc -p extension/tsconfig.json",
    "artifact:report": "node scripts/artifact-report.mjs report",
    "artifact:runtime": "node scripts/artifact-report.mjs runtime",
    "artifact:http": "node scripts/artifact-report.mjs http",
    "demo:transcript": "node scripts/demo-transcript.mjs",
    "community:preview": "node scripts/community-submission.mjs",
    "promotion:preview": "node scripts/promotion-preview.mjs bundle",
    "promotion:discovery": "node scripts/promotion-preview.mjs discovery",
    "promotion:trust": "node scripts/promotion-preview.mjs trust",
    "promotion:demo": "node scripts/promotion-demo.mjs",
    "benchmark:validate": "node scripts/real-benchmark-validate.mjs",
    "video:kit": "node scripts/video-kit.mjs",
    "pretest": "node scripts/sweep-temp.mjs --older-than 2h --max-entries 500 --max-scan 50000 --time-budget 3s --quiet",
    "test": "node --test tests/**/*.js src/**/*.test.js",
    "temp:sweep": "node scripts/sweep-temp.mjs --max-entries 3000 --max-scan 50000 --time-budget 60s",
    "lint": "eslint --max-warnings=0 bin src tests",
    "typecheck": "tsc -p tsconfig.json",
    "test:pty": "node --test tests/test-cli-pty-matrix.js tests/test-cli-commercial.js",
    "test:extension": "npm --prefix extension run test:unit",
    "release:check": "npm run check:version-metadata && npm test && npm run lint && npm run typecheck && npm run test:extension && npm audit --audit-level=high && npm run docs:check && node scripts/secret-scan.mjs && npm run stage2:parity && npm pack --dry-run --json && npm run test:packed-install && node VERIFY_CMD.mjs && npm run release:verify",
    "docs:check": "node scripts/documentation-consistency.mjs",
    "release:verify": "node scripts/release-verify.mjs",
    "release:manifest": "node scripts/release-manifest.mjs validate",
    "release:manifest:generate": "node scripts/release-manifest.mjs generate",
    "registry:compat": "node scripts/registry-compat.mjs",
    "registry:verify": "node scripts/registry-compat.mjs",
    "commercial:readiness": "node scripts/commercial-readiness.mjs --json",
    "readiness:all": "node scripts/readiness-checks.mjs --target all",
    "readiness:mcp": "node scripts/readiness-checks.mjs --target mcp",
    "readiness:mcp:live": "node scripts/mcp-live-readiness.mjs",
    "readiness:checks": "node scripts/readiness-checks.mjs --target all",
    "stage2:parity": "node scripts/stage2-parity.mjs",
    "release:artifacts": "node scripts/release-artifact-check.mjs",
    "extension:marketplace:check": "npm run typecheck:extension && node scripts/marketplace-compat.mjs",
    "extension:commercial:check": "npm run typecheck:extension && node scripts/extension-commercial-check.mjs",
    "test:release-artifacts": "node --test tests/test-release-artifacts.js",
    "test:packed-install": "node scripts/packed-install-smoke.mjs",
    "start": "node bin/minitok.js"
  },
  "keywords": [
    "ai",
    "coding",
    "autonomous",
    "workflow",
    "cli",
    "llm",
    "code-review",
    "planning",
    "verifier",
    "code-generation",
    "developer-tools",
    "repository-automation",
    "ai-agent",
    "mcp-server"
  ],
  "author": "Flotic LC.",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/floticinfo/minitok.git"
  },
  "bugs": {
    "url": "https://github.com/floticinfo/minitok/issues"
  },
  "homepage": "https://minitok.dev",
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "js-yaml": "^4.3.2",
    "undici": "^8.10.1"
  },
  "files": [
    "bin/",
    "src/",
    "!src/cli/commands/admin-activate.js",
    "!src/**/*.test.js",
    "!src/pipeline/test-seam.js",
    "!src/runtime/test-seam.js",
    "!src/runtime/**/*.test-seam.js",
    "!extension/",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "DEMO_EVIDENCE.md",
    "BENCHMARK_EVIDENCE.json",
    "VIDEO_MEASUREMENT_KIT.md",
    "VIDEO_MEASUREMENT_RECORD.example.json",
    "VIDEO_NARRATION.md",
    "PROMOTION_KIT.md",
    "LAUNCH_CHECKLIST.md",
    "promotion-posts/",
    "EULA.md",
    "POLICY.md",
    "DATA_CLASSIFICATION.md"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "eslint": "^10.9.1",
    "typescript": "^5.7.2"
  },
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "type": "commonjs"
}
